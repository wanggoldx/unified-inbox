PORT=3001
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here

# Database
DATABASE_URL="file:./dev.db"

# Gmail OAuth
GMAIL_CLIENT_ID=your_google_client_id
GMAIL_CLIENT_SECRET=your_google_client_secret
GMAIL_REDIRECT_URI=http://localhost:3001/api/accounts/gmail/callback

# Outlook OAuth
OUTLOOK_CLIENT_ID=your_microsoft_client_id
OUTLOOK_CLIENT_SECRET=your_microsoft_client_secret
OUTLOOK_REDIRECT_URI=http://localhost:3001/api/accounts/outlook/callback

# Encryption (for storing access tokens)
ENCRYPTION_KEY=your_32_character_hex_key_here
